{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rando.dammaretz.fr/schemas/catalog.schema.json",
  "title": "open-rando route catalog",
  "description": "Contract for data/catalog.json, consumed by the website and the mobile client: curated tracks only. POIs live in pois/ and are joined through links/<id>.json. Fields are only ever added as optional; removing or retyping one is a breaking change.",
  "type": "object",
  "required": [
    "generated_at",
    "source",
    "license",
    "routes"
  ],
  "additionalProperties": false,
  "properties": {
    "generated_at": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "routes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/route"
      }
    }
  },
  "$defs": {
    "route": {
      "type": "object",
      "required": [
        "id",
        "slug",
        "path_ref",
        "path_name",
        "description",
        "osm_relation_id",
        "distance_km",
        "elevation_gain_m",
        "elevation_loss_m",
        "max_elevation_m",
        "min_elevation_m",
        "bbox",
        "region",
        "departement",
        "difficulty",
        "is_circular_trail",
        "terrain",
        "geojson_path",
        "gpx_path",
        "last_updated",
        "elevation_path",
        "poi_counts"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "path_ref": {
          "type": "string",
          "minLength": 1
        },
        "path_name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "osm_relation_id": {
          "type": "integer"
        },
        "distance_km": {
          "type": "number",
          "minimum": 0
        },
        "elevation_gain_m": {
          "type": "integer",
          "minimum": 0
        },
        "elevation_loss_m": {
          "type": "integer",
          "minimum": 0
        },
        "max_elevation_m": {
          "type": "integer"
        },
        "min_elevation_m": {
          "type": "integer"
        },
        "bbox": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "region": {
          "type": "string"
        },
        "departement": {
          "type": "string"
        },
        "difficulty": {
          "type": "string",
          "enum": [
            "easy",
            "moderate",
            "difficult",
            "very_difficult",
            "unknown"
          ]
        },
        "is_circular_trail": {
          "type": "boolean"
        },
        "terrain": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "geojson_path": {
          "type": "string",
          "minLength": 1
        },
        "gpx_path": {
          "type": "string",
          "minLength": 1
        },
        "last_updated": {
          "type": "string",
          "format": "date"
        },
        "image_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "landmarks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/landmark"
          }
        },
        "trail_segment_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Mapped segments the trail is made of; more than one means it has gaps."
        },
        "trail_gap_km": {
          "type": "number",
          "minimum": 0,
          "description": "Straight-line distance of the gaps between segments. Not included in distance_km."
        },
        "elevation_path": {
          "type": "string"
        },
        "poi_counts": {
          "$ref": "#/$defs/poi_counts"
        }
      }
    },
    "landmark": {
      "type": "object",
      "required": [
        "name",
        "kind",
        "lat",
        "lon"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "lat": {
          "type": "number"
        },
        "lon": {
          "type": "number"
        },
        "elevation_m": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "poi_counts": {
      "description": "How many linked POIs of each kind the track has. The POIs themselves live in the POI grid; links/<id>.json says which ones belong to this track.",
      "type": "object",
      "required": [
        "train_station",
        "bus_stop",
        "hotel",
        "camping",
        "train_station_with_rail_service"
      ],
      "additionalProperties": false,
      "properties": {
        "train_station": {
          "type": "integer",
          "minimum": 0
        },
        "bus_stop": {
          "type": "integer",
          "minimum": 0
        },
        "hotel": {
          "type": "integer",
          "minimum": 0
        },
        "camping": {
          "type": "integer",
          "minimum": 0
        },
        "train_station_with_rail_service": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
