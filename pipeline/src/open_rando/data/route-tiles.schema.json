{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rando.dammaretz.fr/schemas/route-tiles.schema.json",
  "title": "open-rando per-route tile manifest",
  "description": "Contract for data/routes/{id}/pmtiles.json, written by tiles/build-routes.py and read by the mobile client. Each `squares` entry is a [col, row] pair that must exist in grid.json; that cross-check lives in tiles/tile_manifests.py.",
  "type": "object",
  "required": [
    "route_id",
    "source_snapshot",
    "bbox",
    "squares"
  ],
  "additionalProperties": false,
  "properties": {
    "route_id": {
      "type": "string",
      "minLength": 1
    },
    "source_snapshot": {
      "type": "string",
      "pattern": "^[0-9]{8}$"
    },
    "bbox": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "squares": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "integer",
            "minimum": 0
          }
        ],
        "items": false,
        "minItems": 2
      }
    }
  }
}
