# Local OSRM walking router for the `link` stage (station -> trail walking
# distances). Replaces the public demo server, which is rate limited and not
# meant for bulk use. Runs in Docker on the France PBF that Makefile.osm
# already downloads.
#
#   make -f Makefile.osrm          build the foot graph (once per PBF; ~30 min, ~16 GB RAM for France)
#   make -f Makefile.osrm serve    start the router on http://localhost:5000 (detached)
#   make -f Makefile.osrm status   show whether the router answers
#   make -f Makefile.osrm stop     stop the router
#   make -f Makefile.osrm clean    drop the built graph (keeps the PBF)
#
# For a quick trial, build a region instead of France:
#   make -f Makefile.osrm PBF_URL=https://download.geofabrik.de/europe/france/bourgogne-latest.osm.pbf
# The pipeline reads OPEN_RANDO_OSRM_URL (default http://localhost:5000).

OPEN_RANDO_CACHE_DIR ?= $(HOME)/.cache/open-rando

OSM_DIR ?= $(OPEN_RANDO_CACHE_DIR)/osm
OSRM_DIR ?= $(OPEN_RANDO_CACHE_DIR)/osrm-graph
PBF_URL ?= https://download.geofabrik.de/europe/france-latest.osm.pbf
PBF_NAME := $(notdir $(PBF_URL))
PBF := $(OSM_DIR)/$(PBF_NAME)
GRAPH_NAME := $(PBF_NAME:.osm.pbf=)
GRAPH := $(OSRM_DIR)/$(GRAPH_NAME).osrm
# Last step of the MLD pipeline; its output marks a usable graph.
GRAPH_READY := $(OSRM_DIR)/$(GRAPH_NAME).osrm.mldgr

OSRM_IMAGE ?= ghcr.io/project-osrm/osrm-backend:v6.0.0
OSRM_PORT ?= 5000
CONTAINER := open-rando-osrm
DOCKER_RUN := docker run --rm -v $(OSRM_DIR):/data $(OSRM_IMAGE)

.PHONY: all check serve status stop clean

all: check $(GRAPH_READY)

check:
	@command -v docker >/dev/null || { echo "docker not found: install Docker Desktop or colima"; exit 1; }
	@docker info >/dev/null 2>&1 || { echo "Docker daemon not running"; exit 1; }
	@command -v curl >/dev/null || { echo "curl not found"; exit 1; }

$(PBF):
	mkdir -p $(OSM_DIR)
	curl -L --fail -o $@.part $(PBF_URL)
	mv $@.part $@

# osrm-extract writes next to its input, so the PBF is linked into the graph dir.
$(GRAPH_READY): $(PBF)
	mkdir -p $(OSRM_DIR)
	ln -sf $(PBF) $(OSRM_DIR)/$(PBF_NAME)
	docker run --rm -v $(OSRM_DIR):/data -v $(OSM_DIR):$(OSM_DIR):ro $(OSRM_IMAGE) \
		osrm-extract -p /opt/foot.lua /data/$(PBF_NAME)
	$(DOCKER_RUN) osrm-partition /data/$(GRAPH_NAME).osrm
	$(DOCKER_RUN) osrm-customize /data/$(GRAPH_NAME).osrm

serve: check $(GRAPH_READY)
	@docker rm -f $(CONTAINER) >/dev/null 2>&1 || true
	docker run -d --name $(CONTAINER) -p $(OSRM_PORT):5000 -v $(OSRM_DIR):/data $(OSRM_IMAGE) \
		osrm-routed --algorithm mld --max-table-size 1000 /data/$(GRAPH_NAME).osrm
	@echo "OSRM starting on http://localhost:$(OSRM_PORT) (graph load takes ~1 min for France)"

status:
	@curl -sf "http://localhost:$(OSRM_PORT)/table/v1/foot/2.35,48.85;2.36,48.86" >/dev/null \
		&& echo "OSRM answers on http://localhost:$(OSRM_PORT)" \
		|| { echo "OSRM not answering on http://localhost:$(OSRM_PORT)"; exit 1; }

stop:
	docker rm -f $(CONTAINER)

clean:
	rm -rf $(OSRM_DIR)
